# Sparrow Configuration
# Copy this file to .env and fill in your values

# Anthropic API key for Fetch, Media, and Librarian agent loops
ANTHROPIC_API_KEY=

# TMDB API key for metadata and artwork (free at themoviedb.org)
TMDB_API_KEY=

# Backend host/port
SPARROW_HOST=127.0.0.1
# Browser port; Compose maps this host port to the container's internal 8888.
SPARROW_PORT=8888

# For a source installation on a trusted home network, set both:
# SPARROW_HOST=0.0.0.0
# SPARROW_ALLOW_LAN=1
# For Docker Compose, bind to the server's LAN address instead:
# SPARROW_BIND_ADDRESS=192.168.1.20
# Guided external HTTPS/access setup remains deferred.

# Comma-separated cross-origin development clients. The production UI is
# served same-origin and does not need an entry here.
# SPARROW_ALLOWED_ORIGINS=http://localhost:3000

# Data directory (where config, db, and artwork are stored)
SPARROW_DATA_DIR=./data

# v3 agent model tiers (optional overrides)
# SPARROW_SMART_MODEL=claude-sonnet-5
# SPARROW_CHEAP_MODEL=claude-haiku-4-5-20251001
# Optional local speech-model directory. Compose paths must exist inside the container.
# The image bundles Whisper base; a model stored in its persistent volume can use:
# SPARROW_TRANSCRIPTION_MODEL=/data/models/whisper-medium
# Subtitle timing evidence prefers /data/models/whisper-large-v3-turbo, then
# /data/models/whisper-medium, then base; or name a model directory:
# SPARROW_EVIDENCE_MODEL=/data/models/whisper-large-v3-turbo
# Subtitle agent (Preferences → Subtitle agent; needs an Anthropic key):
# SPARROW_SUBTITLE_MODEL=claude-opus-5-5
# SPARROW_SUBTITLE_EFFORT=medium
# With an OpenAI key, Opus manages cheap page checkers (defaults below):
# OPENAI_API_KEY=
# SPARROW_SUBTITLE_CONTRACTOR=gpt-6-luna
# SPARROW_SUBTITLE_VERIFIER=gpt-6-sol   (off disables either)
# Dollars per title; unset uses the household per-case allowance (Defaults):
# SPARROW_SUBTITLE_BUDGET=

# Re-enable the demoted deterministic curator loop (legacy v2)
# SPARROW_LEGACY_CURATOR=1
