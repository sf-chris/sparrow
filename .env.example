# Sparrow Configuration
# Copy this file to .env and fill in your values

# Anthropic API key for Fetch, Media, and Librarian agent loops
ANTHROPIC_API_KEY=

# TMDB API key for metadata and artwork (free at themoviedb.org)
TMDB_API_KEY=

# Backend host/port
SPARROW_HOST=127.0.0.1
SPARROW_PORT=8888

# To use Sparrow from another device on a trusted home network, set both:
# SPARROW_HOST=0.0.0.0
# SPARROW_ALLOW_LAN=1
# Public-internet exposure is unsupported until authentication ships.

# Comma-separated cross-origin development clients. The production UI is
# served same-origin and does not need an entry here.
# SPARROW_ALLOWED_ORIGINS=http://localhost:3000

# Data directory (where config, db, and artwork are stored)
SPARROW_DATA_DIR=./data

# v3 agent model tiers (optional overrides)
# SPARROW_SMART_MODEL=claude-sonnet-5
# SPARROW_CHEAP_MODEL=claude-haiku-4-5-20251001

# Re-enable the demoted deterministic curator loop (legacy v2)
# SPARROW_LEGACY_CURATOR=1
